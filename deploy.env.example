# Copy to deploy.env (gitignored) and fill in. Read by scripts/deploy-*.sh.

# The machine that runs the renderer container (ssh target).
HOST=renderer.example.lan
# Address on HOST to publish the renderer on (the one the frame is allowed to reach).
BIND=192.0.2.10
# Optional: verify HOST's ssh key against another known_hosts name (e.g. when
# connecting by IP to a host pinned under its DNS name).
# SSH_HOST_KEY_ALIAS=renderer.example.lan

# The frame's serial device when it's plugged into HOST (remote deploys and
# USB mode). /dev/serial/by-id/... is stable across reboots.
DEVICE=/dev/serial/by-id/usb-MicroPython_Board_in_FS_mode_XXXXXXXXXXXXXXXX-if00
# mpremote on HOST (remote deploys only).
MPREMOTE='~/inky-venv/bin/mpremote'

# Over-the-air signing key (64 hex chars, 0600; scripts/sign_ota.py --new-key PATH).
OTA_KEY_FILE=$HOME/.config/inky-almanac/ota-key.txt
